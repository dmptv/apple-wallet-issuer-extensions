{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_runner: watch",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": {
        "owner": "dart",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^__no_match__$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(riverpod_generator|json_serializable|injectable_generator).* on \\d+ inputs;",
          "endsPattern": "(Built with build_runner|Failed after)"
        }
      }
    },
    {
      "label": "build_runner: build",
      "type": "shell",
      "command": "dart run build_runner build --delete-conflicting-outputs",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
